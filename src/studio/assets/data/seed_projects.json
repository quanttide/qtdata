      "blueprint": {
        "steps": [
          "采集原始数据 — 飞书议事档案导出（lark-cli drive +export：提案/会议纪要/简报）",
          "解析文档结构 — 提取编号、提案人、poll 标记、议程结构",
          "决议标准化 — 对齐决议 schema（id/title/owner/due/status/溯源）",
          "纪要决议提取 — 从议程中提取决定类记录（决定/通过/落实/确定）",
          "档案落库 — 一决议一文件（YAML），索引聚合",
          "治理输出 — 逾期推导、责任人分布、治理视图 JSON",
          "周会报告 — 生成周会决议汇总与质量指标（编号错位/辩论记录/决议落档）"
        ],
        "exceptions": [
          {
            "label": "无责任人",
            "strategy": "标记\"未指定\"，治理视图提示补全——创建决议时 owner 必填"
          },
          {
            "label": "无完成期限",
            "strategy": "逾期推导跳过，不误报——期限缺失本身是治理信号"
          },
          {
            "label": "编号双轨",
            "strategy": "提案按发布周、会议按召开周编号，跨文档错位检测（错位率 100%）"
          },
          {
            "label": "纪要无决议记录",
            "strategy": "标记表决-决议断链，提示表决引擎/决议归档缺失"
          }
        ]
      },
