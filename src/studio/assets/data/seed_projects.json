      "blueprint": {
        "steps": [
          "维护官方来源清单 — 16 个市场逐国整理监管机构站点（FDA、Federal Register、European Commission、EUR-Lex、MDCG、NMPA、CMDE 及各国家监管机构）",
          "增量采集 — 按市场与来源抓取新发布的法规、Guidance／Draft Guidance、MDCG 文件与监管通知",
          "变更识别 — 比对上一版落地结果，识别法规修订、标准变化、产品分类变化、注册政策变化",
          "结构化落库 — 按八类监控维度归档，每条带官方原文链接、文档 ID 与抓取时间",
          "官方来源核验 — 结论必须能回到官方原文；二手解读只作线索，不作结论依据",
          "情报输出 — 按市场与维度生成法规情报条目与变更摘要，供客户直接使用"
        ],
        "exceptions": [
          {
            "label": "站点改版",
            "strategy": "解析规则按站点单独配置，抓取连续失败即告警，人工校正后回填"
          },
          {
            "label": "多语言与发布节奏不一",
            "strategy": "逐市场配置语言与轮询频率，不假设统一节奏"
          },
          {
            "label": "只有二手报道",
            "strategy": "标记为线索、不落库，待官方发布后补齐原文"
          },
          {
            "label": "同一文件多次修订",
            "strategy": "按官方文档 ID + 版本号去重，保留修订历史"
          }
        ]
      },
